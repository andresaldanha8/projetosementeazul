<?xml version="1.0"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:o="urn:schemas-microsoft-com:office:office"
 xmlns:x="urn:schemas-microsoft-com:office:excel">
 <Styles>
  <Style ss:ID="Header">
   <Alignment ss:Horizontal="Left" ss:Vertical="Center" ss:WrapText="1"/>
   <Font ss:Bold="1"/>
   <Interior ss:Color="#E8F1FF" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="ResumoHeader">
   <Font ss:Bold="1"/>
   <Interior ss:Color="#E8F1FF" ss:Pattern="Solid"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1"/>
   </Borders>
  </Style>
  <Style ss:ID="ResumoData">
   <Alignment ss:Horizontal="Right"/>
  </Style>
  <Style ss:ID="MoneyCell">
   <NumberFormat ss:Format="R$ #,##0.00"/>
   <Alignment ss:Horizontal="Right"/>
  </Style>
 </Styles>
 <Worksheet ss:Name="Inscrições">
  <Table>
   <Row>
    <Cell ss:StyleID="Header"><Data ss:Type="String">NOME COMPLETO,MODALIDADE,CATEGORIA,IDADE,STATUS PAGAMENTO,VALOR,DATA PAGAMENTO,MÉTODO PAGAMENTO,NOME DA EQUIPE/PARCEIRO,TELEFONE,EMAIL,DATA INSCRIÇÃO,HORÁRIO INSCRIÇÃO</Data></Cell>
   </Row>
   
   <!-- Espaço para dados -->
   <Row></Row>
   <Row></Row>
   <Row></Row>
   <Row></Row>
   <Row></Row>

   <!-- Resumo Geral -->
   <Row>
    <Cell ss:StyleID="ResumoHeader"><Data ss:Type="String">📊 RESUMO GERAL DO EVENTO</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">Total de Participantes</Data></Cell>
    <Cell ss:StyleID="ResumoData" ss:Formula="COUNTA(A2:A1000)"/>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">Inscrições Confirmadas (Pagas)</Data></Cell>
    <Cell ss:StyleID="ResumoData" ss:Formula="COUNTIF(E2:E1000,&quot;Pago&quot;)"/>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">Inscrições Pendentes</Data></Cell>
    <Cell ss:StyleID="ResumoData" ss:Formula="COUNTIF(E2:E1000,&quot;Pendente&quot;)"/>
   </Row>

   <!-- Modalidades -->
   <Row>
    <Cell ss:StyleID="ResumoHeader"><Data ss:Type="String">📋 INSCRIÇÕES POR MODALIDADE</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">🎾 Beach Tennis</Data></Cell>
    <Cell ss:StyleID="ResumoData" ss:Formula="COUNTIF(B2:B1000,&quot;*Beach Tennis*&quot;)"/>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">⚽ Futebol de Areia</Data></Cell>
    <Cell ss:StyleID="ResumoData" ss:Formula="COUNTIF(B2:B1000,&quot;*Futebol de Areia*&quot;)"/>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">⚽ Torneio de Pênaltis</Data></Cell>
    <Cell ss:StyleID="ResumoData" ss:Formula="COUNTIF(B2:B1000,&quot;*Pênaltis*&quot;)"/>
   </Row>

   <!-- Financeiro -->
   <Row>
    <Cell ss:StyleID="ResumoHeader"><Data ss:Type="String">💰 RESUMO FINANCEIRO</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">Total Recebido</Data></Cell>
    <Cell ss:StyleID="MoneyCell" ss:Formula="SUMIF(E2:E1000,&quot;Pago&quot;,F2:F1000)"/>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">Total Pendente</Data></Cell>
    <Cell ss:StyleID="MoneyCell" ss:Formula="SUMIF(E2:E1000,&quot;Pendente&quot;,F2:F1000)"/>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">Previsão Total</Data></Cell>
    <Cell ss:StyleID="MoneyCell" ss:Formula="SUM(F2:F1000)"/>
   </Row>
  </Table>
 </Worksheet>
</Workbook>